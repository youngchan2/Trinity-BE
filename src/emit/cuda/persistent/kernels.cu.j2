__device__ bool dispatch(Context const& c, Task const& task, void* storage) {
  switch (task.operation) {
{% for launch in launches %}    case {{ launch.operation }}: return operation_{{ launch.operation }}(c.bindings, Tile{task.x, task.y, task.z}, storage, PersistentRuntime{c, task});
{% endfor %}    default: fail(c, kInvalidLaunch); return false;
  }
}

__global__ void persistent_kernel(Context c) {
  extern __shared__ __align__(128) unsigned char storage[];
  __shared__ int slot;
  __shared__ bool reserved;

  for (;;) {
    if (threadIdx.x == 0) {
      reserved = false;
      slot = failed(c) ? -2 : claim(c, reserved);
      if (slot == -1 && device_atomic(&header(c)->complete).load(cuda::memory_order_acquire) == kTasksPerRank
          && dependencies_ready(c, kOutputDependencies[c.rank])) slot = -2;
    }

    __syncthreads();

    if (slot == -2) {
        return;
    }

    if (slot == -1) {
        __nanosleep(64);
        __syncthreads();
        continue;
    }

    auto const& task = kTasks[c.rank * kTasksPerRank + slot];
    before_task(c, task);
    if (!dispatch(c, task, storage)) return;
    complete_task(c, task, reserved);
  }
}
